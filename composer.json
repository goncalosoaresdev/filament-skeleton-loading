{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mortalkiller/filament-skeleton-loading",
    "description": "Skeleton loading states for Filament: lazy widgets, deferred tables and lazy sections show the shape of what is coming instead of a grey box or a spinner.",
    "homepage": "https://github.com/mortalkiller/filament-skeleton-loading",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "skeleton",
        "loading",
        "placeholder"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pedro Monteiro",
            "homepage": "https://pedromonteiro.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/mortalkiller/filament-skeleton-loading/issues",
        "source": "https://github.com/mortalkiller/filament-skeleton-loading",
        "docs": "https://docs.pedromonteiro.dev/filament-skeleton-loading/"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.12.6 || ^5.8.1",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mortalkiller/filament-package-standard": "^2.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MortalKiller\\FilamentSkeletonLoading\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MortalKiller\\FilamentSkeletonLoading\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MortalKiller\\FilamentSkeletonLoading\\SkeletonLoadingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "format": "pint",
        "browser:prepare": [
            "@php vendor/bin/testbench package:discover --ansi",
            "@php vendor/bin/testbench filament:assets --ansi"
        ],
        "serve": "@php vendor/bin/testbench serve"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
